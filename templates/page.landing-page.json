        "text_TzRjxD": {
          "type": "text",
          "settings": {
            "width": "half",
            "subheading": "",
            "title": "",
            "text": "<p>Dune Jewelry creates beautiful, handcrafted pieces made with sand and natural elements collected from beaches, destinations, and meaningful places around the world. Each design captures a personal memory -  a moment, a place, or a story - preserved forever in jewelry you can wear every day.<br/><br/>If you’re searching for<strong> Dune Jewelry</strong> or looking to place a <strong>special request</strong>, we’re here to help. While Dune Jewelry is not sold directly on our site, we assist customers with special orders, product guidance, and availability.<br/><br/>Send us the styles you love or <a href=\"https://www.milanojewelry.com/pages/contact\" title=\"https://www.milanojewelry.com/pages/contact\"><em>book a one-on-one appointment.</em></a> Our team will help with details, customization, and ordering your perfect Dune Jewelry piece.<br/><br/></p>",
            "button_label": "contact us",
            "button_link": "https://www.milanojewelry.com/pages/contact",
            "button_style": "primary",
            "text_alignment": "center"
          }
