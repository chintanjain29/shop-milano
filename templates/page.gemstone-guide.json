    "rich_text_tFANat": {
      "type": "rich-text",
      "blocks": {
        "text_k9t3V9": {
          "type": "text",
          "settings": {
            "text": "<p>Gemstone jewelry is defined by individuality. No two stones are exactly alike, which makes each piece inherently unique.</p><p>Understanding the key factors behind gemstone quality allows you to choose a piece that reflects both your style and your standards.</p>",
            "enlarge_text": false
          }
        }
      },
