    "ss_simple_faq_fnE4JW": {
      "type": "ss-simple-faq",
      "blocks": {
        "text_ykzGbk": {
          "type": "text",
          "settings": {
            "question": "What is the most important factor when buying a gemstone?",
            "answer": "<p>Color is typically the most important factor, followed by clarity and cut.<br/></p>"
          }
        },
        "text_KbcWdT": {
          "type": "text",
          "settings": {
            "question": "Are treated gemstones less valuable?",
            "answer": "<p>Not necessarily. Many treatments are standard in the industry, but transparency is essential.</p>"
          }
        },
        "text_n8Liy7": {
          "type": "text",
          "settings": {
            "question": "Which gemstones are best for everyday wear?",
            "answer": "<p>Sapphires and rubies are among the most durable options.</p>"
          }
        },
        "text_zmQQ8B": {
          "type": "text",
          "settings": {
            "question": "Do gemstones hold value over time?",
            "answer": "<p>Some rare gemstones can retain or increase value, but most purchases are driven by aesthetic and personal preference.</p>"
          }
        }
      },
