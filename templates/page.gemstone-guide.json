    "rich_text_gapFcf": {
      "type": "rich-text",
      "blocks": {
        "heading_PYt4AH": {
          "type": "heading",
          "settings": {
            "title": "Why Choose Milano Jewelry",
            "use_h1": false
          }
        },
        "text_6ba8CR": {
          "type": "text",
          "settings": {
            "text": "<p>At Milano Jewelry, every gemstone is selected for its color, quality, and craftsmanship.</p><p>We offer:</p><ul><li>Carefully sourced natural gemstones<br/></li><li>Transparent disclosure of treatments<br/></li><li>Fine craftsmanship and setting quality<br/></li><li>Customization options<br/></li></ul><p>Our focus is to provide clarity and confidence at every stage of your purchase.</p>",
            "enlarge_text": false
          }
        }
      },
