    "custom_liquid_9KcLBP": {
      "type": "custom-liquid",
      "disabled": true,
      "name": "Custom Liquid",
      "settings": {
        "full_width": true,
        "code": "<style>\n.milano-payment-section {\n  background: #f7f2ee;\n  padding: 70px 30px;\n  text-align: center;\n}\n\n.milano-payment-section h2 {\n  font-size: 30px;\n  line-height: 1.2;\n  color: #00205b;\n  margin-bottom: 24px;\n  font-weight: 400;\n}\n\n.milano-payment-section .payment-intro {\n  max-width: 950px;\n  margin: 0 auto 55px;\n  font-size: 15px;\n  line-height: 1.7;\n  color: #222222;\n}\n\n.payment-grid {\n  display: grid;\n  grid-template-columns: repeat(3, 1fr);\n  gap: 40px 30px;\n  max-width: 1400px;\n  margin: 0 auto;\n}\n\n.payment-item {\n  padding: 10px 20px;\n  transition: all 0.3s ease;\n}\n\n.payment-item:hover {\n  transform: translateY(-4px);\n}\n\n.payment-item img {\n  height: 42px;\n  width: auto;\n  margin-bottom: 22px;\n  object-fit: contain;\n}\n\n.payment-item h3 {\n  font-size: 24px;\n  line-height: 1.3;\n  color: #00205b;\n  margin-bottom: 14px;\n  font-weight: 500;\n}\n\n.payment-item p {\n  font-size: 16px;\n  line-height: 1.7;\n  color: #333333;\n  margin: 0 auto;\n  max-width: 320px;\n}\n\n.payment-button {\n  margin-top: 55px;\n}\n\n.payment-button a {\n  display: inline-block;\n  padding: 14px 36px;\n  border: 1px solid #00205b;\n  color: #00205b;\n  text-decoration: none;\n  font-size: 16px;\n  transition: all 0.3s ease;\n}\n\n.payment-button a:hover {\n  background: #00205b;\n  color: #ffffff;\n}\n\n@media screen and (max-width: 989px) {\n  .payment-grid {\n    grid-template-columns: repeat(2, 1fr);\n  }\n\n  .milano-payment-section h2 {\n    font-size: 40px;\n  }\n}\n\n@media screen and (max-width: 749px) {\n  .payment-grid {\n    grid-template-columns: 1fr;\n    gap: 45px;\n  }\n\n  .milano-payment-section {\n    padding: 55px 20px;\n  }\n\n  .milano-payment-section h2 {\n    font-size: 26px;\n  }\n\n  .milano-payment-section .payment-intro {\n    font-size: 16px;\n  }\n\n  .payment-item h3 {\n    font-size: 22px;\n  }\n}\n</style>\n\n<section class=\"milano-payment-section\">\n\n  <h2>Flexible Payment Options</h2>\n\n  <div class=\"payment-intro\">\n    We’re proud to offer flexible payment options online and in-store for our collection of engagement rings, wedding bands, lab diamonds, and fine jewelry. From seamless digital wallets to secure financing solutions, Milano Jewelry provides convenient ways to purchase your perfect piece.\n  </div>\n\n  <div class=\"payment-grid\">\n\n    <div class=\"payment-item\">\n      <img src=\"https://cdn-icons-png.flaticon.com/512/174/174861.png\" alt=\"PayPal\">\n      <h3>PayPal</h3>\n      <p>Secure and seamless checkout using your PayPal account.</p>\n    </div>\n\n    <div class=\"payment-item\">\n      <img src=\"https://cdn-icons-png.flaticon.com/512/5968/5968279.png\" alt=\"Apple Pay\">\n      <h3>Apple Pay</h3>\n      <p>Fast and effortless payments directly from your Apple device.</p>\n    </div>\n\n    <div class=\"payment-item\">\n      <img src=\"https://cdn-icons-png.flaticon.com/512/2991/2991148.png\" alt=\"Google Pay\">\n      <h3>Google Pay</h3>\n      <p>Easy mobile checkout with secure one-tap payments.</p>\n    </div>\n\n    <div class=\"payment-item\">\n      <img src=\"https://cdn-icons-png.flaticon.com/512/196/196578.png\" alt=\"Credit Cards\">\n      <h3>Credit Cards</h3>\n      <p>We accept all major credit cards for secure transactions.</p>\n    </div>\n\n    <div class=\"payment-item\">\n      <img src=\"https://upload.wikimedia.org/wikipedia/commons/8/84/Venmo_logo.png\" alt=\"Venmo\">\n      <h3>Venmo</h3>\n      <p>Available through our concierge team for personalized assistance.</p>\n    </div>\n\n    <div class=\"payment-item\">\n      <img src=\"https://cdn-icons-png.flaticon.com/512/2830/2830284.png\" alt=\"Wire Transfer\">\n      <h3>Wire Transfer</h3>\n      <p>Preferred for larger purchases and concierge-level support.</p>\n    </div>\n\n  </div>\n\n  <div class=\"payment-button\">\n    <a href=\"/pages/contact\">Contact Us</a>\n  </div>\n\n</section>"
      }
    },
    "rich_text_H3q4ky": {
