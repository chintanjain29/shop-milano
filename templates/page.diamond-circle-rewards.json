milano-vip-tier {\n      font-size: 28px;\n    }\n  }\n</style>\n\n<div class=\"milano-vip-section\">\n\n  <div class=\"milano-vip-heading\">\n    <h2>VIP Tiers</h2>\n\n    <p>\n      Unlock elevated rewards, exclusive benefits, and premium experiences as you move through the Milano Diamond Circle.\n    </p>\n  </div>\n\n  <div class=\"milano-vip-grid\">\n\n    <!-- SILVER -->\n    <div class=\"milano-vip-card\">\n\n      <div class=\"milano-vip-image\">\n        <img src=\"https://cdn.shopify.com/s/files/1/0367/6287/8085/files/milano10.22final-42-com.jpg?v=1770392541\" alt=\"Silver Tier\">\n      </div>\n\n      <div class=\"milano-vip-content\">\n\n        <div class=\"milano-vip-tier\">\n          Silver\n        </div>\n\n        <div class=\"milano-vip-points\">\n          0+ Diamond Circle Points\n        </div>\n\n        <div class=\"milano-vip-description\">\n          Begin your Milano Diamond Circle journey with member-only rewards, birthday gifts, and referral benefits.\n        </div>\n\n      </div>\n    </div>\n\n    <!-- GOLD -->\n    <div class=\"milano-vip-card\">\n\n      <div class=\"milano-vip-image\">\n        <img src=\"https://cdn.shopify.com/s/files/1/0367/6287/8085/files/milano10.22final-36-com.jpg?v=1770470704L\" alt=\"Gold Tier\">\n      </div>\n\n      <div class=\"milano-vip-content\">\n\n        <div class=\"milano-vip-tier\">\n          Gold\n        </div>\n\n        <div class=\"milano-vip-points\">\n          5,000+ Diamond Circle Points\n        </div>\n\n        <div class=\"milano-vip-description\">\n          Enjoy elevated rewards, priority access to launches, and exclusive member experiences curated for our loyal collectors.\n        </div>\n\n      </div>\n    </div>\n\n    <!-- PLATINUM -->\n    <div class=\"milano-vip-card\">\n\n      <div class=\"milano-vip-image\">\n        <img src=\"https://cdn.shopify.com/s/files/1/0367/6287/8085/files/milano10.22final-33.jpg?v=1764855836\" alt=\"Platinum Tier\">\n      </div>\n\n    