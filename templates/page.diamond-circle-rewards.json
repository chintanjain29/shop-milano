    "custom_liquid_iF4Xtz": {
      "type": "custom-liquid",
      "name": "Custom Liquid",
      "settings": {
        "full_width": true,
        "code": "<style>\n  .milano-rewards-section {\n    padding: 10px 10px;\n    background: #FFFFFF;\n    font-family: 'Geist', sans-serif;\n  }\n\n  /* HEADING */\n  .milano-rewards-heading-wrapper {\n    text-align: center;\n    margin-bottom: 50px;\n  }\n\n  .milano-rewards-heading {\n    font-size: 28px;\n    line-height: 1.1;\n    font-weight: 100;\n    letter-spacing: -0.01px;\n    color: #091350;\n    margin-bottom: 4px;\n  }\n\n  .milano-rewards-subheading {\n    font-size: 16px;\n    line-height: 1.7;\n    color: #5C5F6A;\n    max-width: 720px;\n    margin: 0 auto;\n  }\n\n  .milano-rewards-grid {\n    max-width: 1200px;\n    margin: 0 auto;\n    display: grid;\n    grid-template-columns: repeat(3, 1fr);\n    gap: 24px;\n  }\n\n  .milano-reward-card {\n    background: #F4F4F0;\n    border: 1px solid #EBEBDF;\n    border-radius: 20px;\n    padding: 38px 28px;\n    transition: all 0.3s ease;\n    text-align: center;\n    display: flex;\n    flex-direction: column;\n    align-items: center;\n    justify-content: center;\n    min-height: 280px;\n  }\n\n  .milano-reward-card:hover {\n    transform: translateY(-4px);\n    border-color: #091350;\n    box-shadow: 0 10px 25px rgba(9, 19, 80, 0.06);\n  }\n\n  .milano-reward-icon {\n    width: 64px;\n    height: 64px;\n    border-radius: 50%;\n    background: #FFFFFF;\n    border: 1px solid #EBEBDF;\n    display: flex;\n    align-items: center;\n    justify-content: center;\n    margin-bottom: 24px;\n  }\n\n  .milano-reward-icon svg {\n    width: 28px;\n    height: 28px;\n    stroke: #091350;\n  }\n\n  .milano-reward-title {\n    font-size: 18px;\n    line-height: 1.25;\n    font-weight: 500;\n    color: #101820;\n    margin-bottom: 14px;\n    letter-spacing: -0.5px;\n  }\n\n  .milano-reward-description {\n    font-size: 15px;\n    line-height: 1.7;\n    color: #5C5F6A;\n    max-width: 300px;\n    margin-bottom: 24px;\n  }\n\n  .milano-reward-points {\n    font-size: 13px;\n    font-weight: 600;\n    letter-spacing: 1.2px;\n    text-transform: uppercase;\n    color: #091350;\n  }\n\n  @media screen and (max-width: 990px) {\n    .milano-rewards-grid {\n      grid-template-columns: repeat(2, 1fr);\n    }\n  }\n\n  @media screen and (max-width: 768px) {\n\n    .milano-rewards-heading {\n      font-size: 24px;\n    }\n\n    .milano-rewards-subheading {\n      font-size: 15px;\n    }\n\n    .milano-rewards-grid {\n      grid-template-columns: 1fr;\n    }\n\n    .milano-reward-card {\n      min-height: auto;\n      padding: 32px 24px;\n    }\n\n    .milano-reward-title {\n      font-size: 18px;\n    }\n  }\n</style>\n\n<div class=\"milano-rewards-section\">\n\n  <!-- HEADING -->\n  <div class=\"milano-rewards-heading-wrapper\">\n    <h2 class=\"milano-rewards-heading\">\n      Ways to Earn\n    </h2>\n\n    <p class=\"milano-rewards-subheading\">\n      Earn Diamond Circle Points through shopping, engagement, and exclusive member activities.\n    </p>\n  </div>\n\n  <div class=\"milano-rewards-grid\">\n\n    <!-- Create Account -->\n    <div class=\"milano-reward-card\">\n      <div class=\"milano-reward-icon\">\n        <svg fill=\"none\" stroke-width=\"1.8\" viewBox=\"0 0 24 24\">\n          <path d=\"M12 12c2.761 0 5-2.239 5-5s-2.239-5-5-5-5 2.239-5 5 2.239 5 5 5z\"/>\n          <path d=\"M4 22c0-4 3-7 8-7s8 3 8 7\"/>\n        </svg>\n      </div>\n      <div class=\"milano-reward-title\">Create an Account</div>\n      <div class=\"milano-reward-description\">\n        Join the Milano Diamond Circle and unlock exclusive member rewards.\n      </div>\n      <div class=\"milano-reward-points\">\n        200 Diamond Circle Points\n      </div>\n    </div>\n\n    <!-- Order -->\n    <div class=\"milano-reward-card\">\n      <div class=\"milano-reward-icon\">\n        <svg fill=\"none\" stroke-width=\"1.8\" viewBox=\"0 0 24 24\">\n          <path d=\"M6 6h15l-1.5 9h-12z\"/>\n          <path d=\"M6 6L4 2H1\"/>\n          <circle cx=\"9\" cy=\"20\" r=\"1\"/>\n          <circle cx=\"18