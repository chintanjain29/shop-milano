      "blocks": {
        "question_UCbnKi": {
          "type": "question",
          "settings": {
            "title": "Is Diamond Circle Available in Stores?",
            "answer": "<p>Yes, any purchases in stores within the last 12 months are eligible to earn Diamond Circle Points. In order to add your purchase, please submit a request with a copy of your receipt here: <a href=\"https://contact.gorgias.help/forms/bowuvttr\" title=\"https://contact.gorgias.help/forms/bowuvttr\">Submit Request.<br/></a>Please note, Diamond Circle points or rewards cannot be redeemed in stores. </p>"
          }
        },
        "question_AWURVr": {
          "type": "question",
          "settings": {
            "title": "Can I redeem Diamond Circle Rewards in Stores?",
            "answer": "<p>Diamond Circle Rewards are only redeemable online. </p><p>You are able to earn points for instore purchases within 12 months of purchase. </p>"
          }
        },
        "question_EeQHaC": {
          "type": "question",
          "settings": {
            "title": "Do Diamond Circle Points Expire?",
            "answer": "<p>No, your Diamond Circle Points do not expire. Once you've redeemed your Diamond Circle Points for Cash Coupon, you have 1 year from the date of redemption to utilize that Coupon.</p>"
          }
        },
        "question_LbJ8nG": {
          "type": "question",
          "settings": {
            "title": "Do I need a Milano account to use Diamond Circle?",
            "answer": "<p>Yes, you must have or create an account at  https://shopmilano.com/account/register before or at the time of purchase in order to participate.</p>"
          }
        },
        "question_BAfEJC": {
          "type": "question",
          "settings": {
            "title": "What can I redeem my points for?",
            "answer": "<ul><li>2,000 Points for $100 Off, min purchase of $300</li><li>5,000 Points for $250 Off, min purchase of $750</li><li>10,000 Points for $500 Off, min purchase of $1500</li></ul>"
          }
        },
        "question_7LiNnG": {
          "type": "question",
          "settings": {
            "title": "How do I check my points balance?",
            "answer": "<p>Sign in to your account and click on the ‘Rewards’ button appearing at the bottom left corner of your screen. You would be able to see your Points balance.</p>"
          }
        },
        "question_NW4z6H": {
          "type": "question",
          "settings": {
            "title": "What happens to my points if I return the product?",
            "answer": "<p>When you return an item, you lose the associated points you originally earned by buying the item.</p>"
          }
        },
        "question_MQgK76": {
          "type": "question",
          "settings": {
            "title": "What is the referral program?",
            "answer": "<p>Diamond Circle Members have the ability to refer their friends and family with personalized offers and earn points and rewards.</p>"
          }
        },
        "question_jyzWff": {
          "type": "question",
          "settings": {
            "title": "How do referrals work?",
            "answer": "<p>Diamond Circle members can refer a friend or family, and we will send them a link to a personalized coupon code. When the friend or family completes a purchase using that code, they will save $50 on their first order, and the Diamond Circle member will receive $100 to use towards future jewelry purchase online.</p>"
          }
        },
        "question_dix4KN": {
          "type": "question",
          "settings": {
            "title": "Can I combine Diamond Circle Rewards with other promotions?",
            "answer": "<p>Absolutely! Diamond Circle Rewards can be redeemed for cash coupons. They are just as good as cash.</p>"
          }
        }
      },
