      "settings": {
        "full_width": true,
        "code": "<style>\n.milano-affiliate {\n  width: 100%;\n  margin: 0;\n  font-family: 'Geist', -apple-system, BlinkMacSystemFont, sans-serif;\n  color: #101820;\n}\n\n/* CONTAINER */\n.milano-container {\n  max-width: 1400px;\n  margin: 0 auto;\n  padding: 40px 40px; /* reduced from 60 */\n}\n\n/* tighter spacing between sections */\n.milano-container + .milano-container {\n  margin-top: 20px;\n}\n\n/* HEADINGS */\n.section-title {\n  text-align: center;\n  font-size: 26px;\n  letter-spacing: 2px;\n  margin-bottom: 16px;\n  color: #00205B;\n  font-weight: 500;\n}\n\n/* DIVIDER */\n.divider {\n  width: 50px;\n  height: 2px;\n  background: #00205B;\n  margin: 0 auto 30px;\n}\n\n/* GRID */\n.grid {\n  display: flex;\n  gap: 20px;\n  justify-content: center;\n  flex-wrap: wrap;\n}\n\n/* CARDS */\n.card {\n  flex: 1;\n  min-width: 280px;\n  max-width: 380px;\n  padding: 28px;\n  background: #F4F4F0;\n  border-radius: 10px;\n  transition: 0.3s ease;\n  border: 1px solid #E5E5E5;\n}\n\n.card:hover {\n  transform: translateY(-4px);\n}\n\n.card h3 {\n  font-size: 18px;\n  margin-bottom: 10px;\n}\n\n.card p {\n  font-size: 15px;\n  line-height: 1.6;\n  color: #555;\n}\n\n/* FULL WIDTH CTA */\n.cta-full {\n  background: #F4F4F0;\n  padding: 60px 20px;\n  text-align: center;\n  margin-top: 30px;\n}\n\n.cta-full h2 {\n  font-size: 28px;\n  margin-bottom: 10px;\n}\n\n.cta-full p {\n  font-size: 16px;\n  margin-bottom: 20px;\n  color: #555;\n}\n\n/* BUTTON */\n.btn {\n  display: inline-block;\n  padding: 14px 34px;\n  background: #00205B;\n  color: #fff;\n  text-decoration: none;\n  border-radius: 6px;\n  font-size: 13px;\n  letter-spacing: 1px;\n  text-transform: uppercase;\n  transition: 0.3s ease;\n}\n\n.btn:hover {\n  background: #091350;\n}\n\n/* MOBILE */\n@media (max-width: 768px) {\n  .milano-container {\n    padding: 30px 20px;\n  }\n\n  .cta-full {\n    padding: 40px 20px;\n  }\n}\n</style>\n\n\n<div class=\"milano-affiliate\">\n\n  <!-- WHY -->\n  <div class=\"milano-container\">\n    <div class=\"section-title\">WHY PARTNER WITH MILANO</div>\n    <div class=\"divider\"></div>\n\n    <div class=\"grid\">\n      <div class=\"card\">\n        <h3>Premium Products</h3>\n        <p>\n          Lab-grown diamonds, gemstone jewelry, and fine pieces designed for modern consumers and high conversion.\n        </p>\n      </div>\n\n      <div class=\"card\">\n        <h3>High Conversion</h3>\n        <p>\n          Trusted by over 400,000 customers with strong demand, premium positioning, and high average order value.\n        </p>\n      </div>\n\n      <div class=\"card\">\n        <h3>Earn More</h3>\n        <p>\n          High-value products mean better commissions per sale with strong purchase intent.\n        </p>\n      </div>\n    </div>\n  </div>\n\n\n  <!-- HOW -->\n  <div class=\"milano-container\">\n    <div class=\"section-title\">HOW IT WORKS</div>\n    <div class=\"divider\"></div>\n\n    <div class=\"grid\">\n      <div class=\"card\">\n        <h3>Join</h3>\n        <p>\n          Sign up in minutes and access your dashboard.<br><br>\n          <a href=\"https://app.impact.com/campaign-promo-signup/MilanoJewelry.brand?execution=e18s1&\" style=\"color:#00205B; text-decoration:underline;\">\n            Sign up here →\n          </a>\n        </p>\n      </div>\n\n      <div class=\"card\">\n        <h3>Promote</h3>\n        <p>\n          Share your referral links across your content, social platforms, and campaigns.\n        </p>\n      </div>\n\n      <div class=\"card\">\n        <h3>Earn</h3>\n        <p>\n          Earn 5 - 10% commission on every successful referral with high-value jewelry purchases.\n        </p>\n      </div>\n    </div>\n  </div>\n\n\n  <!-- FULL WIDTH CTA -->\n  <div class=\"cta-full\">\n    <h2>Start Earning with Milano</h2>\n    <p>Join today and turn your audience into revenue.</p>\n\n    <a href=\"\" class=\"btn\">\n      START EARNING\n    </a>\n\n    <p style=\"margin-top:15px; font-size:14px;\">\n      Already an affiliate?\n      <a href=\"https://app.impact.com/campaign-promo-signup/MilanoJewelry.brand?execution=e18s1&\" style=\"color:#00205B; text-decoration:underline;\">\n        Login here →\n      </a>\n    </p>\n  </div>\n\n</div>"
