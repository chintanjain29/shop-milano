    "rich_text_gFfzfQ": {
      "type": "rich-text",
      "blocks": {
        "heading_qL8zf6": {
          "type": "heading",
          "settings": {
            "title": "Why Diamonds Are Used in Jewelry",
            "use_h1": false
          }
        },
        "text_zEze6c": {
          "type": "text",
          "settings": {
            "text": "<p>Diamonds are widely used in jewelry due to their combination of durability and visual appeal.</p><p>They offer:</p><ul><li>Long-lasting brilliance<br/></li><li>Resistance to scratching and wear<br/></li><li>Versatility across designs and settings<br/></li></ul><p>This makes them suitable for everyday wear as well as heirloom pieces.</p>",
            "enlarge_text": false
          }
        }
      },
