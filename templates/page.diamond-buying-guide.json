    "rich_text_tFANat": {
      "type": "rich-text",
      "blocks": {
        "text_k9t3V9": {
          "type": "text",
          "settings": {
            "text": "<p>A well-informed purchase is the key to choosing the right diamond. By understanding the 4Cs, certification standards, and your personal priorities, you can select a diamond that reflects both your style and your expectations.</p>",
            "enlarge_text": false
          }
        }
      },
