    "rich_text_hAiEAk": {
      "type": "rich-text",
      "blocks": {
        "heading_D3QV9X": {
          "type": "heading",
          "settings": {
            "title": "Diamond Certification: Why It Matters",
            "use_h1": false
          }
        },
        "text_cE74mh": {
          "type": "text",
          "settings": {
            "text": "<p>A diamond certificate is an independent grading report that verifies the quality and authenticity of a diamond.</p><p>Reputable certification bodies include:</p><ul><li>Gemological Institute of America<br/></li><li>American Gem Society<br/></li><li>IGI (International Gemological Institute)<br/></li></ul><p>These reports provide an unbiased evaluation of the 4Cs and ensure transparency in your purchase.</p>",
            "enlarge_text": false
          }
        }
      },
      "block_order": [
        "heading_D3QV9X",
        "text_cE74mh"
      ],
      "custom_css": [
        ".subheading {color: #002058; font-size: 20px; margin-bottom: 6px;}"
      ],
      "name": "Rich text",
      "settings": {
        "height": "small",
