    "rich_text_y79RTG": {
      "type": "rich-text",
      "blocks": {
        "subheading_zM9mTm": {
          "type": "subheading",
          "settings": {
            "subheading": "Carat Weight: Size and Value"
          }
        },
        "text_dRCcFk": {
          "type": "text",
          "settings": {
            "text": "<p>Carat refers to the weight of a diamond, which often influences its perceived size and price.</p><ul><li><strong>Lower carat weights</strong>: More budget-friendly and practical<br/></li><li><strong>Higher carat weights</strong>: Greater visual impact and higher cost<br/></li></ul><p>It is important to balance carat weight with cut quality, as cut has a greater impact on overall appearance.</p>",
            "enlarge_text": false
          }
        }
      },
      "block_order": [
        "subheading_zM9mTm",
        "text_dRCcFk"
      ],
