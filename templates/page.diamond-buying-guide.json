    "rich_text_gapFcf": {
      "type": "rich-text",
      "blocks": {
        "subheading_8Qy9CD": {
          "type": "subheading",
          "settings": {
            "subheading": "Why Choose Milano Jewelry"
          }
        },
        "text_6ba8CR": {
          "type": "text",
          "settings": {
            "text": "<p>At Milano Jewelry, every diamond is selected with a focus on quality, transparency, and craftsmanship.</p><p>We offer:</p><ul><li>Certified diamonds (IGI and GIA)<br/></li><li>Transparent pricing through direct sourcing<br/></li><li>Customization options<br/></li><li>Dedicated customer support<br/></li></ul><p>Our goal is to help you make a confident, informed decision—whether you choose a lab-grown or natural diamond.</p>",
            "enlarge_text": false
          }
        }
      },
      "block_order": [
        "subheading_8Qy9CD",
        "text_6ba8CR"
      ],
