    "ss_simple_faq_fnE4JW": {
      "type": "ss-simple-faq",
      "blocks": {
        "text_ykzGbk": {
          "type": "text",
          "settings": {
            "question": "Which of the 4Cs is most important?",
            "answer": "<p>Cut is generally the most important, as it directly affects brilliance and sparkle.</p>"
          }
        },
        "text_KbcWdT": {
          "type": "text",
          "settings": {
            "question": "How do I get the best value when buying a diamond?",
            "answer": "<p>Focus on cut quality and consider slightly lower color or clarity grades for better pricing.</p>"
          }
        },
        "text_n8Liy7": {
          "type": "text",
          "settings": {
            "question": "Is certification necessary when buying a diamond?",
            "answer": "<p>Yes. Certification ensures authenticity and provides an unbiased quality assessment.</p>"
          }
        },
        "text_zmQQ8B": {
          "type": "text",
          "settings": {
            "question": "Should I choose a lab-grown or natural diamond?",
            "answer": "<p>This depends on your priorities—lab-grown diamonds offer better value, while natural diamonds offer rarity.</p>"
          }
        }
      },
