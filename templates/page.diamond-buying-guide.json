    "rich_text_bX84gd": {
      "type": "rich-text",
      "blocks": {
        "heading_HKpFN4": {
          "type": "heading",
          "settings": {
            "title": "Diamond Care and Maintenance",
            "use_h1": false
          }
        },
        "text_jMDRxP": {
          "type": "text",
          "settings": {
            "text": "<p>Proper care ensures your diamond retains its brilliance over time.</p><p><strong>Regular Cleaning</strong><br/><br/>Use mild soap and a soft brush to remove buildup.</p><p><strong>Professional Inspection</strong><br/><br/>Have your jewelry checked periodically for setting security.</p><p><strong>Safe Storage</strong><br/><br/>Store diamonds separately to prevent scratches.</p>",
            "enlarge_text": false
          }
        }
      },
      "block_order": [
        "heading_HKpFN4",
        "text_jMDRxP"
      ],
