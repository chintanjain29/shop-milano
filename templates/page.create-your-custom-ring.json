    "rich_text_dNGVBi": {
      "type": "rich-text",
      "blocks": {
        "heading_XiCR6K": {
          "type": "heading",
          "settings": {
            "title": "From Concept to Creation",
            "use_h1": false
          }
        },
        "text_XtcPLn": {
          "type": "text",
          "settings": {
            "text": "<p>Watch your vision come to life. With our design process, you’ll see your dream ring evolve from an initial CAD wireframe to a lifelike 3D render. This interactive comparison lets you slide between the technical blueprint and the finished design, giving you complete confidence in every detail before your ring is brought to life.</p>",
            "enlarge_text": true
          }
        },
        "button_4raJzi": {
          "type": "button",
