    "ss_simple_faq_EapgYf": {
      "type": "ss-simple-faq",
      "blocks": {
        "text_TKgBCj": {
          "type": "text",
          "settings": {
            "question": "What is custom jewelry?",
            "answer": "<p>Custom jewelry refers to made-to-order fine jewelry designed specifically for you. Each piece is handcrafted based on your preferences, allowing you to personalize the metal, gemstones, setting, and overall design.</p>"
          }
        },
        "text_XJ6Eqw": {
          "type": "text",
          "settings": {
            "question": "How does the custom jewelry process work?",
            "answer": "<p>Our custom jewelry process begins with submitting a request or booking a consultation. You’ll share your ideas or inspiration, and our team will guide you through design options, pricing, and timelines before production begins.</p>"
          }
        },
        "text_kwnP4X": {
          "type": "text",
          "settings": {
            "question": "Can I create custom jewelry from a reference image or idea?",
            "answer": "<p>Yes. You can create custom jewelry using reference images, sketches, or links. Our designers will translate your inspiration into a beautifully crafted, wearable piece.</p>"
          }
        },
        "text_VrC4Wd": {
          "type": "text",
          "settings": {
            "question": "What materials can I choose for custom jewelry?",
            "answer": "<p>We offer a wide selection of fine materials, including 14K and 18K yellow, white, and rose gold, platinum, lab-grown diamonds, natural diamonds, and carefully selected gemstones.</p>"
          }
        },
        "text_N6zRci": {
          "type": "text",
          "settings": {
            "question": "How long does custom jewelry take to make?",
            "answer": "<p>Most custom jewelry pieces are completed within <strong>4–6 weeks</strong> after final design approval. Timelines may vary depending on design complexity and material availability.</p>"
          }
        },
        "text_dx8hFW": {
          "type": "text",
          "settings": {
            "question": "Is custom jewelry more expensive than ready-to-ship jewelry?",
            "answer": "<p>Custom jewelry pricing depends on the design, materials, and craftsmanship involved. We provide transparent pricing and a detailed quote before production begins.</p>"
          }
        },
        "text_mJGmU6": {
          "type": "text",
          "settings": {
            "question": "Can changes be made after approving the custom jewelry design?",
            "answer": "<p>Minor changes may be possible before production starts. Once your custom jewelry enters production, changes may be limited or not feasible.</p>"
          }
        },
        "text_ddfmmP": {
          "type": "text",
          "settings": {
            "question": "Are custom jewelry pieces eligible for returns or exchanges?",
            "answer": "<p>Because custom jewelry is made specifically for you, all custom pieces are typically <strong>final sale</strong>. However, we stand behind the quality and craftsmanship of every piece we create.</p>"
          }
        },
        "text_rhQpF9": {
          "type": "text",
          "settings": {
            "question": "Does custom jewelry come with a warranty?",
            "answer": "<p>Yes. All custom jewelry is covered by our lifetime guarantee against manufacturing defects.</p>"
          }
        },
        "text_K4zRPw": {
          "type": "text",
          "settings": {
            "question": "How do I get started with a custom jewelry request?",
            "answer": "<p>To begin, simply fill out our custom jewelry request form or book a one-on-one consultation. Our team will guide you from design to delivery.</p>"
          }
        }
      },
