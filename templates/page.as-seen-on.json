    "rich_text_kJNz4g": {
      "type": "rich-text",
      "blocks": {
        "subheading_eFYBrQ": {
          "type": "subheading",
          "settings": {
            "subheading": "A glimpse into the women, celebrations, and everyday moments styled in Milano."
          }
        },
        "text_wyMY8y": {
          "type": "text",
          "settings": {
            "text": "<p>Welcome to our favorite corner of the Milano world. This is where we celebrate our style muses, midnight confidantes, and ultimate friends of the brand living, laughing, and—of course—stacking in <a href=\"https://www.milanojewelry.com/collections/all-products\" title=\"https://www.milanojewelry.com/collections/all-products\">Milano fine jewelry</a>. From intimate book club debates over low lighting at Zero Bond to late-night afterparty glitz, see how our community styles their favorite pieces to match their own unique rhythm. Because if you ask us, real diamonds are meant to be lived in.</p>",
            "enlarge_text": false
          }
        }
      },
      "block_order": [
        "subheading_eFYBrQ",
        "text_wyMY8y"
