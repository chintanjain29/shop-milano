      "type": "influencer-shop-the-collection",
      "blocks": {
        "collection_VmtYDj": {
          "type": "collection",
          "settings": {
            "heading": "Bruna Petrillo & Monika Clarke",
            "content": "<p>A new favorite tradition has entered the chat. ✨ We’ve been having the absolute best time styling the gorgeous hosts of The Margins book club—our girls <strong>@brunapetrillo </strong>and <strong>@monikaclarke</strong>—for their exclusive evenings at Zero Bond NYC.<br/><br/>Think deep conversations, an inspiring room of women, and the ultimate fine jewelry mood board come to life. It’s the perfect reminder that diamonds are meant to be lived in, told stories in, and stacked to perfection.<br/><br/>#MilanoInMotion #TheMarginsBookClub #ZeroBond<br/><br/></p>",
            "button_title": "Shop the collection",
            "button_link": "",
            "placeholder_image": "shopify://shop_images/Radomskiy_production-112015.jpg"
          }
        }
      },
      "block_order": [
