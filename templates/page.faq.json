      "blocks": {
        "question-1": {
          "type": "question",
          "settings": {
            "title": "Do I need an Account to purchase?",
            "answer": "<p>No, you are not required to create an account in order to make a purchase. However, creating an account will enable you to save personal information and payment details for faster checkout process. It will also allow you to track and maintain information about your purchase.</p>"
          }
        },
        "question-2": {
          "type": "question",
          "settings": {
            "title": "What payment methods do you accept?",
            "answer": "<p>Milano accepts all major credit cards as well as PayPal and Bitcoin. Milano also offers financing through Affirm and Synchrony. </p>"
          }
        },
        "question_TqgJbz": {
          "type": "question",
          "settings": {
            "title": "What is Affirm and Synchrony?",
            "answer": "<p>Affirm and Synchrony are alternative payment methods that provide flexible financing over a period of time.</p><p>After applying, you will receive a decision on your eligibility to purchase with payments over 3, 6 or 12 months.</p><p>There are no hidden fees and any APR or Loan Options will be clearly mentioned prior to your purchase.</p><p>To learn more about financing options please visit our <a href=\"/pages/payment-financing\" title=\"Payment financing\">Payment & Financing</a> page.</p>"
          }
        },
        "question_a4Vm6A": {
          "type": "question",
          "settings": {
            "title": "Can I combine discount codes/offers?",
            "answer": "<p>We do not offer discount combination or stacking. Discount codes available online may not be combined with discounts given In-Store or vice versa.</p>"
          }
        }
      },
      "block_order": [
