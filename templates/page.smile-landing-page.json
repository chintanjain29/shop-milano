        "full_width": true,
        "code": "<style>\n  .milano-referral-section {\n    font-family: 'Geist', sans-serif;\n    background: #F4F4F0;\n    border-radius: 28px;\n    overflow: hidden;\n    max-width: 1400px;\n    margin: 80px auto;\n  }\n\n  .milano-referral-wrapper {\n    display: grid;\n    grid-template-columns: 1fr 1fr;\n    align-items: stretch;\n  }\n\n  .milano-referral-content {\n    padding: 80px 70px;\n    display: flex;\n    align-items: center;\n    justify-content: center;\n  }\n\n  .milano-referral-inner {\n    max-width: 520px;\n    text-align: center;\n  }\n\n  .milano-referral-subtitle {\n    font-size: 15px;\n    color: #5C5F6A;\n    margin-bottom: 18px;\n    letter-spacing: 0.4px;\n  }\n\n  .milano-referral-title {\n    font-size: 54px;\n    line-height: 1.05;\n    font-weight: 500;\n    color: #091350;\n    margin-bottom: 24px;\n    letter-spacing: -1.5px;\n  }\n\n  .milano-referral-description {\n    font-size: 17px;\n    line-height: 1.8;\n    color: #5C5F6A;\n    margin-bottom: 36px;\n  }\n\n  .milano-referral-highlight {\n    color: #091350;\n    font-weight: 600;\n  }\n\n  .milano-referral-form {\n    display: flex;\n    gap: 14px;\n    justify-content: center;\n    margin-bottom: 18px;\n  }\n\n  .milano-referral-input {\n    width: 100%;\n    max-width: 340px;\n    height: 56px;\n    border: 1px solid #D8D8CF;\n    background: #FFFFFF;\n    border-radius: 14px;\n    padding: 0 18px;\n    font-size: 15px;\n    font-family: 'Geist', sans-serif;\n    color: #101820;\n  }\n\n  .milano-referral-input:focus {\n    outline: none;\n    border-color: #091350;\n  }\n\n  .milano-referral-button {\n    height: 56px;\n    padding: 0 34px;\n    border: none;\n    border-radius: 14px;\n    background: #091350;\n    color: #FFFFFF;\n    font-size: 15px;\n    font-weight: 500;\n    font-family: 'Geist', sans-serif;\n    cursor: pointer;\n    transition: all 0.3s ease;\n  }\n\n  .milano-referral-button:hover {\n    background: #051E4A;\n  }\n\n  .milano-referral-note {\n    font-size: 13px;\n    color: #7B7E87;\n  }\n\n  .milano-referral-image {\n    position: relative;\n    min-height: 620px;\n  }\n\n  .milano-referral-image img {\n    width: 100%;\n    height: 100%;\n    object-fit: cover;\n    display: block;\n  }\n\n  @media screen and (max-width: 1024px) {\n    .milano-referral-wrapper {\n      grid-template-columns: 1fr;\n    }\n\n    .milano-referral-image {\n      min-height: 420px;\n    }\n\n    .milano-referral-content {\n      padding: 60px 30px;\n    }\n\n    .milano-referral-title {\n      font-size: 42px;\n    }\n  }\n\n  @media screen and (max-width: 768px) {\n    .milano-referral-form {\n      flex-direction: column;\n    }\n\n    .milano-referral-input {\n      max-width: 100%;\n    }\n\n    .milano-referral-button {\n      width: 100%;\n    }\n\n    .milano-referral-title {\n      font-size: 36px;\n    }\n\n    .milano-referral-description {\n      font-size: 15px;\n    }\n  }\n</style>\n\n<div class=\"milano-referral-section\">\n  <div class=\"milano-referral-wrapper\">\n\n    <!-- LEFT CONTENT -->\n    <div class=\"milano-referral-content\">\n      <div class=\"milano-referral-inner\">\n\n        <div class=\"milano-referral-subtitle\">\n          Refer a Friend\n        </div>\n\n        <h2 class=\"milano-referral-title\">\n          GIVE $100,<br>\n          GET $100\n        </h2>\n\n        <div class=\"milano-referral-description\">\n          Invite your friends to discover Milano Jewelry and enjoy exclusive rewards together.\n          Your friend receives <span class=\"milano-referral-highlight\">$100 OFF</span> their first purchase, and you receive <span class=\"milano-referral-highlight\">$100 OFF</span> once they complete their order.\n        </div>\n\n       \n\n        <div class=\"milano-referral-note\">\n          Share timeless luxury with the people you love.\n        </div>\n\n      </div>\n    </div>\n\n    <!-- RIGHT IMAGE -->\n    <div class=\"milano-referral-image\">\n      <img \n        src=\"https://cdn.shopify.com/s/files/1/0367/6287/8085/files/Mothers_day_mobile_banner.png?v=1776101467\"\n        alt=\"Milano Jewelry Referral Program\"\n      >\n    </div>\n\n  </div>\n</div>"
      }
    },
    "ss_simple_faq_Wm44Jr": {
      "type": "ss-simple-faq",
      "blocks": {
        "text_VNaVTc": {
          "type": "text",
          "settings": {
            "question": "How does the Milano Diamond Circle rewards program work?",
            "answer": "<p>The Milano Diamond Circle is our loyalty and rewards program that lets members earn Diamond Circle Points through purchases, referrals, reviews, birthdays, and social engagement. Points can be redeemed for exclusive rewards and future savings on Milano Jewelry purchases.</p>"
          }
        },
        "text_Err38W": {
          "type": "text",
          "settings": {
            "question": "How do I earn Diamond Circle Points?",
            "answer": "<p>You can earn Diamond Circle Points by:</p><ul><li>Creating an account</li><li>Shopping online</li><li>Referring friends</li><li>Following Milano Jewelry on social media</li><li>Reviewing products</li><li>Celebrating your birthday</li></ul><p>Every eligible purchase automatically earns points when you are logged into your account.</p>"
          }
        },
        "text_3YQben": {
          "type": "text",
          "settings": {
            "question": "Can I earn rewards for in-store purchases?",
            "answer": "<p>Yes. Select in-store purchases may qualify for Diamond Circle rewards. Customers can submit their purchase receipt through our rewards form to request points for eligible purchases.</p>"
          }
        },
        "text_FrUyFk": {
          "type": "text",
          "settings": {
            "question": "How do referrals work?",
            "answer": "<p>When you refer a friend to Milano Jewelry, your friend receives $100 OFF their first eligible purchase, and you receive a $100 reward once their order is successfully completed.</p>"
          }
        },
        "text_KUnLyR": {
          "type": "text",
          "settings": {
            "question": "Do Diamond Circle Points expire?",
            "answer": "<p>Diamond Circle Points may expire after a period of account inactivity. We recommend staying active in your account and using your rewards regularly to continue enjoying member benefits.</p>"
          }
        },
        "text_ydw9PE": {
          "type": "text",
          "settings": {
            "question": "When will my Diamond Circle Points appear in my account?",
            "answer": "<p>Points from purchases are typically added after your order is fulfilled. Referral rewards, reviews, and bonus activities may take up to a few days to appear in your Diamond Circle account.</p>"
          }
        },
        "text_pFWqH7": {
          "type": "text",
          "settings": {
            "question": "Do I need an account to redeem rewards?",
            "answer": "<p>Yes. You must create a Milano Jewelry account to earn, track, and redeem Diamond Circle Points and referral rewards.</p>"
          }
        }
      },
