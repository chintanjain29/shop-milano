{% doc %}
  @prompt
    A frequent answers and questions section

{% enddoc %}
{% assign ai_gen_id = block.id | replace: '_', '' | downcase %}

{% style %}
  .ai-faq-section-{{ ai_gen_id }} {
    padding: {{ block.settings.section_padding }}px 0;
    background-color: {{ block.settings.background_color }};
  }

  .ai-faq-container-{{ ai_gen_id }} {
    max-width: {{ block.settings.max_width }}px;
    margin: 0 auto;
    padding:0 20px;
  }

  .ai-faq-header-{{ ai_gen_id }} {
    text-align: {{ block.settings.text_alignment }};
    margin-bottom: {{ block.settings.header_spacing }}px;
  }

  .ai-faq-title-{{ ai_gen_id }} {
    font-size: {{ block.settings.title_size }}px;
    color: {{ block.settings.title_color }};
    margin: 0 0 {{ block.settings.title_margin }}px 0;font-weight: 600;
  }

  .ai-faq-subtitle-{{ ai_gen_id }} {
    font-size: {{ block.settings.subtitle_size }}px;
    color: {{ block.settings.subtitle_color }};
    margin: 0;line-height: 1.5;
  }

  .ai-faq-list-{{ ai_gen_id }} {
    list-style: none;
    padding: 0;
    margin: 0;
    max-width: {{ block.settings.content_max_width }}px;
    margin-left: auto;
    margin-right: auto;
  }

  .ai-faq-item-{{ ai_gen_id }} {
    border-bottom: 1px solid {{ block.settings.border_color }};
    margin-bottom: {{ block.settings.item_spacing }}px;
  }

  .ai-faq-item-{{ ai_gen_id }}:last-child {
    border-bottom: none;
    margin-bottom: 0;
  }

  .ai-faq-question-{{ ai_gen_id }} {
    width: 100%;
    background: none;
    border: none;
    text-align: left;
    padding: {{ block.settings.question_padding }}px 40px {{ block.settings.question_padding }}px 0;
    font-size: {{ block.settings.question_size }}px;
    color: {{ block.settings.question_color }};
    cursor: pointer;
    position: relative;
    font-weight: 500;
    line-height: 1.4;
    transition: color 0.3s ease;
  }

  .ai-faq-question-{{ ai_gen_id }}:hover {
    color: {{ block.settings.question_hover_color }};
  }

  .ai-faq-question-{{ ai_gen_id }}:focus {
    outline: 2px solid {{ block.settings.question_hover_color }};
    outline-offset: 2px;
  }

  .ai-faq-icon-{{ ai_gen_id }} {
    position: absolute;
    right: 0;
    top: 50%;
    transform: translateY(-50%);
    width: 24px;
    height: 24px;
    transition: transform 0.3s ease;
  }

  .ai-faq-item-{{ ai_gen_id }}[aria-expanded="true"] .ai-faq-icon-{{ ai_gen_id }} {
    transform: translateY(-50%) rotate(180deg);
  }

  .ai-faq-answer-{{ ai_gen_id }} {
    padding: 0 0 {{ block.settings.answer_padding }}px 0;
    font-size: {{ block.settings.answer_size }}px;
    color: {{ block.settings.answer_color }};
    line-height: 1.6;
    overflow: hidden;
    transition: max-height 0.3s ease, opacity 0.3s ease;
    max-height: 0;
    opacity: 0;
  }

  .ai-faq-item-{{ ai_gen_id }}[aria-expanded="true"] .ai-faq-answer-{{ ai_gen_id }} {
    max-height: 500px;
    opacity: 1;
  }

  .ai-faq-answer-content-{{ ai_gen_id }} {
    padding-top: 10px;
  }

  @media screen and (max-width: 768px) {
    .ai-faq-container-{{ ai_gen_id }} {
      padding: 0 15px;
    }

    .ai-faq-title-{{ ai_gen_id }} {
      font-size: {{ block.settings.title_size | times: 0.8 }}px;
    }

    .ai-faq-question-{{ ai_gen_id }} {
      font-size: {{ block.settings.question_size | times: 0.9 }}px;
      padding-right: 35px;
    }

    .ai-faq-icon-{{ ai_gen_id }} {
      width: 20px;
      height: 20px;
    }
  }
{% endstyle %}

<faq-accordion-{{ ai_gen_id }}
  class="ai-faq-section-{{ ai_gen_id }}"
  {{ block.shopify_attributes }}
>
  <div class="ai-faq-container-{{ ai_gen_id }}">
    {% if block.settings.title != blank or block.settings.subtitle != blank %}
      <div class="ai-faq-header-{{ ai_gen_id }}">
        {% if block.settings.title != blank %}
          <h2 class="ai-faq-title-{{ ai_gen_id }}">{{ block.settings.title }}</h2>
        {% endif %}
        {% if block.settings.subtitle != blank %}
          <div class="ai-faq-subtitle-{{ ai_gen_id }}">{{ block.settings.subtitle }}</div>
        {% endif %}
      </div>
    {% endif %}

    <ul class="ai-faq-list-{{ ai_gen_id }}">
      {% for i in (1..8) %}
        {% assign question_key = 'question_' | append: i %}
        {% assign answer_key = 'answer_' | append: i %}
        {% assign question = block.settings[question_key] %}
        {% assign answer = block.settings[answer_key] %}

        {% if question != blank and answer != blank %}
          <li class="ai-faq-item-{{ ai_gen_id }}" aria-expanded="false">
            <button class="ai-faq-question-{{ ai_gen_id }}" aria-expanded="false">
              {{ question }}
              <svg class="ai-faq-icon-{{ ai_gen_id }}" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                <polyline points="6,9 12,15 18,9"></polyline>
              </svg>
            </button>
            <div class="ai-faq-answer-{{ ai_gen_id }}"><div class="ai-faq-answer-content-{{ ai_gen_id }}">
                {{ answer }}
              </div>
            </div>
          </li>
        {% endif %}
      {% endfor %}
    </ul>

    {% if block.settings.question_1 == blank %}
      <div style="text-align: center; padding: 40px 20px; color: #666; font-style: italic;">
        Add your first question and answer to get started
      </div>
    {% endif %}
  </div>
</faq-accordion-{{ ai_gen_id }}>

<script>
  (function() {
    class FAQAccordion{{ ai_gen_id }} extends HTMLElement {
      constructor() {
        super();
      }

      connectedCallback() {
        this.faqItems = this.querySelectorAll('.ai-faq-item-{{ ai_gen_id }}');
        this.setupEventListeners();
      }

      setupEventListeners() {
        this.faqItems.forEach((item) => {
          const button = item.querySelector('.ai-faq-question-{{ ai_gen_id }}');
          const answer = item.querySelector('.ai-faq-answer-{{ ai_gen_id }}');

          button.addEventListener('click', () => {
            const isExpanded = item.getAttribute('aria-expanded') === 'true';
            
            if ({{ block.settings.allow_multiple | json }} === false) {
              this.faqItems.forEach((otherItem) => {
                if (otherItem !== item) {
                  otherItem.setAttribute('aria-expanded', 'false');
                otherItem.querySelector('.ai-faq-question-{{ ai_gen_id }}').setAttribute('aria-expanded', 'false');
                }
              });
            }

            item.setAttribute('aria-expanded', !isExpanded);
            button.setAttribute('aria-expanded', !isExpanded);});

          button.addEventListener('keydown', (e) => {
            if (e.key === 'Enter' || e.key === ' ') {
              e.preventDefault();
              button.click();
            }
          });
        });
      }
    }

    customElements.define('faq-accordion-{{ ai_gen_id }}', FAQAccordion{{ ai_gen_id }});
  })();
</script>

