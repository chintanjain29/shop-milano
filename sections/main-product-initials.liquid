<script>
    // Function to handle radio button selection
  const parentOther = document.querySelector('.tp-other-option');
  const parentColor = document.querySelector('.tp-color-option');
  parentColor.querySelectorAll('.opt-btn').forEach(function (radioButton) {
    radioButton.addEventListener('change', function () {
      if (this.checked) {
        const selectedColor = this.value.trim().toLowerCase();
        const selectedWeightOption = parentOther.querySelector('.custom-select__listbox .js-option[aria-selected="true"]');
        const selectedWeightValue = selectedWeightOption ? selectedWeightOption.getAttribute('data-value') : null;
        const selectedWeight = selectedWeightValue ? selectedWeightValue.trim().toLowerCase() : '';

        if (!selectedWeightValue) {
          return;
        }

        const productImages = document.querySelectorAll('.tp-media-group');
        if (productImages.length === 0) {  return; }

        productImages.forEach(function(imageElement) {
          if (!imageElement) { return; }
          imageElement.classList.remove('tp-active-image');
        });

        productImages.forEach(function(imageElement) {
          if (!imageElement) { return; }

          var sliderColor = imageElement.getAttribute('data-color') ? imageElement.getAttribute('data-color').trim().toLowerCase() : '';
          var sliderWeight = imageElement.getAttribute('data-weight') ? imageElement.getAttribute('data-weight').trim().toLowerCase() : '';

          if (!sliderColor || !sliderWeight) { return; }

          if (selectedColor === sliderColor && selectedWeight === sliderWeight) {
            imageElement.classList.add('tp-active-image'); // Add class to the matching image
          }
        });

        const productThumbnail = document.querySelectorAll('.tp-media-group-thumbnail');
        if (productThumbnail.length === 0) {  return; }

        productThumbnail.forEach(function(thumbnailElement) {
          if (!thumbnailElement) { return; }
          thumbnailElement.classList.remove('tp-active-image');
        });

        productThumbnail.forEach(function(thumbnailElement) {
          if (!thumbnailElement) { return; }

          var sliderThumbnailColor = thumbnailElement.getAttribute('data-color') ? thumbnailElement.getAttribute('data-color').trim().toLowerCase() : '';
          var sliderThumbnailWeight = thumbnailElement.getAttribute('data-weight') ? thumbnailElement.getAttribute('data-weight').trim().toLowerCase() : '';

          if (!sliderThumbnailColor || !sliderThumbnailWeight) { return; }

          if (selectedColor === sliderThumbnailColor && selectedWeight === sliderThumbnailWeight) {
            thumbnailElement.classList.add('tp-active-image'); // Add class to the matching image
          }
        });
      }
    });
  });




