<div class="tp-section-banner-container-wrapper">
<div class="container mobile-full-container">
  <div class="tp-section-banner-container {% if section.settings.heading == blank and section.settings.content == blank%}tp-no-content{% endif %}">
    
    <div class="tp-banner-content">
      {% if section.settings.heading != blank %}
        <h2 class="banner-content-title">{{ section.settings.heading }}</h2>
      {% endif %}
      {% if section.settings.content != blank %}
       {{ section.settings.content }}
      {% endif %}
    </div>
    
    {% if section.settings.placeholder_image != blank %}
      <div class="tp-banner-image">
        <img src="{{ section.settings.placeholder_image | img_url: 'master' }}" />
      </div>
    {% endif %}
  </div>
</div>
</div>

{% schema %}
{
  "name": "Influencer Banner",
  "class": "tp-section-banner",
  "settings": [
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "Hey! I'm Kim "
    },
    {
      "type": "richtext",
      "id": "content",
      "label": "About"
    },
    {
      "id": "placeholder_image",
      "type": "image_picker",
      "label": "Banner Image"
    }
  ],
  "presets": [
    {
      "name": "Influencer Banner",
    }
  ]
}
{% endschema %}
