<div class="{% if section.settings.use_alt_bg %}use-alt-bg fully-padded-row--medium{% else %}fully-spaced-row--medium{% endif %}">
  <div class="container">
    <div class="flexible-layout">
      <div class="column column--half {% if section.settings.image_position == 'right' %}column--order-push-desktop{% endif %}">
        {% if section.settings.button_link != blank -%}
          <a class="block-link" href="{{ section.settings.button_link }}">
        {%- endif %}
        <div class="image-overlap">
          <div class="image-overlap__image image-overlap__image-1">
            {%- if section.settings.image == blank -%}
              <div class="placeholder-image">{{ 'image' | placeholder_svg_tag: 'placeholder-svg' }}</div>
            {%- else -%}
              {%- render 'image', image: section.settings.image -%}
            {%- endif -%}
          </div>
        </div>
        {% if section.settings.button_link != blank %}</a>{% endif %}
      </div>

      <div class="column column--half align-{{ section.settings.text_alignment }}">
        <div class="feature-text">
          {% if page.metafields.custom.location_title != blank %}
            <h1 class="majortitle in-content">{{ page.metafields.custom.location_title | escape }}</h1>
          {% else %}
            <h1 class="majortitle in-content">{{ section.settings.title | escape }}</h1>
          {% endif %}

          <div class="user-content">{{ section.settings.text }}</div>

          <div class="btn-list">
            {% if section.settings.button_label != blank %}
              <div class="lightly-spaced-row-above">
                <a
                  class="{% if section.settings.button_style != 'link' %}btn btn--{{ section.settings.button_style }}{% else %}small-feature-link{% endif %}"
                  href="{{ section.settings.button_link }}"
                >
                  {{- section.settings.button_label | escape -}}
                </a>
              </div>
            {% endif %}
            <div class="social-btn-list">
              {% capture social_icon_html %}
  <div class="social-links {{ container_class }}">
    <ul class="social-links__list">
      {% if settings.social_twitter_url != blank %}
        <li><a aria-label="Twitter" class="twitter btn btn--secondary" target="_blank" href="{{ settings.social_twitter_url }}">{% render 'icon-twitter' %}</a></li>
      {% endif %}
      {% if settings.social_facebook_url != blank %}
        <li><a aria-label="Facebook" class="facebook btn btn--secondary" target="_blank" href="{{ settings.social_facebook_url }}">{% render 'icon-facebook' %}</a></li>
      {% endif %}
      {% if settings.social_youtube_url != blank %}
        <li><a aria-label="Youtube" class="youtube btn btn--secondary" target="_blank" href="{{ settings.social_youtube_url }}">{% render 'icon-youtube' %}</a></li>
      {% endif %}
      {% if settings.social_vimeo_url != blank %}
        <li><a aria-label="Vimeo" class="vimeo btn btn--secondary" target="_blank" href="{{ settings.social_vimeo_url }}">{% render 'icon-vimeo' %}</a></li>
      {% endif %}
      {% if settings.social_instagram_url != blank %}
        <li><a aria-label="Instagram" class="instagram btn btn--secondary" target="_blank" href="{{ settings.social_instagram_url }}">{% render 'icon-instagram' %}</a></li>
      {% endif %}
      {% if settings.social_pinterest_url != blank %}
        <li><a aria-label="Pinterest" class="pinterest btn btn--secondary" target="_blank" href="{{ settings.social_pinterest_url }}">{% render 'icon-pinterest' %}</a></li>
      {% endif %}

      {% if settings.social_custom_url != blank %}
        <li>
          <a aria-label="{{ icon_setting.alt | escape }}" class="social-custom" target="_blank" href="{{ settings.social_custom_url }}">
            {{ icon_setting | img_url: icon_size | img_tag: icon_setting.alt }}
          </a>
        </li>
      {% endif %}
    </ul>
  </div>
{% endcapture %}
              {% if social_icon_html contains '<li>' %}{{ social_icon_html }}{% endif %}
            </div>
          </div>
        </div>
      </div>
    </div>
  </div>
</div>

{% schema %}
{
  "name": "Location detail iwt 1",
  "class": "section-image-with-text location-detail-iwt",
  "settings": [
    {
      "type": "image_picker",
      "id": "image",
      "label": "Image"
    },
    {
      "type": "text",
      "id": "title",
      "label": "Heading",
      "default": "Image with text"
    },
    {
      "type": "richtext",
      "id": "text",
      "label": "Text",
      "default": "<p>Pair large text with an image to give focus to your chosen product, collection, or blog post. Add details on availability, style, or even provide a review.</p>"
    },
    {
      "type": "text",
      "id": "button_label",
      "label": "Button",
      "default": "Read more"
    },
    {
      "type": "url",
      "id": "button_link",
      "label": "Button link"
    },
    {
      "type": "select",
      "id": "button_style",
      "label": "Button style",
      "default": "primary",
      "options": [
        {
          "label": "Button - primary",
          "value": "primary"
        },
        {
          "label": "Button - secondary",
          "value": "secondary"
        },
        {
          "label": "Link",
          "value": "link"
        }
      ]
    },
    {
      "type": "select",
      "id": "image_position",
      "label": "Image alignment",
      "options": [
        {
          "value": "left",
          "label": "Left"
        },
        {
          "value": "right",
          "label": "Right"
        }
      ]
    },
    {
      "type": "select",
      "id": "text_alignment",
      "label": "Text alignment",
      "options": [
        {
          "value": "left",
          "label": "Left"
        },
        {
          "value": "center",
          "label": "Center"
        },
        {
          "value": "right",
          "label": "Right"
        }
      ]
    },
    {
      "type": "checkbox",
      "id": "use_alt_bg",
      "label": "Use alternate section color",
      "default": false
    }
  ],
  "presets": [
    {
      "name": "Location image with text 1",
      "category": "Text",
      "settings": {}
    }
  ]
}
{% endschema %}
