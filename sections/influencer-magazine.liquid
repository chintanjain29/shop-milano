<div class="container mobile-full-container">
<div class="tp-influencer-magazine-container">
  <div class="tp-influencer-magazine-content">
    <h2 class="banner-content-title">{{ section.settings.heading }}</h2>
    {{ section.settings.content }}
  </div>
  <div class="tp-influencer-magazine-image">
    <img src="{{ section.settings.placeholder_image | img_url: 'master' }}" />  
  </div>
</div>
</div>
{% schema %}
{
  "name": "Influencer Magazine",
  "class": "tp-influencer-magazine",
  "settings": [
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "Heading"
    },
    {
      "type": "richtext",
      "id": "content",
      "label": "Content"
    },
    {
      "id": "placeholder_image",
      "type": "image_picker",
      "label": "Image"
    }
  ],
  "presets": [
    {
      "name": "Influencer Magazine",
    }
  ]
}
{% endschema %}
