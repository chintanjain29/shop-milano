{% if page.url == '/pages/influencer' %} <div class="container mobile-full-container">{% endif %}
<div class="tp-influencer-collection-container" style="background-color:{{ section.settings.background-color }};">
  {% for block in section.blocks %}
    <div class="tp-influencer-collections mobile-full-container">
      {% assign collection = block.settings.collection %}
      <a href="{{ collection.url }}" class="tp-influncer-collection-card">
        
        {% if block.settings.placeholder_image %}
          <img src="{{ block.settings.placeholder_image | img_url: 'master' }}" />
        {% else %}
          <img src="{{ collection.featured_image | img_url: 'master' }}" />
        {% endif %}  

        <div class="influencer-collections-content">
        {% if block.settings.heading != '' or block.settings.heading != blank %}
          <h3 class="tp-influncer-collection-card-title">{{ block.settings.heading }}</h3>
        {% else %}
          <h3>{{ collection.title }}</h3>
        {% endif %}
        
        {% if block.settings.content != '' or block.settings.content != blank %}
         {{ block.settings.content }}
        {% elsif collection.description != blank %}  
        {{ collection.description }}
        {% endif %}
        </div>
      </a>
    </div>
  {% endfor %}

  <div class="tp-influencer-collection-container">
    <a href="{{ section.settings.button_link }}" class="btn small-feature-link white-btn">{{ section.settings.button_title }}</a>
  </div>
</div>
</div>


{% schema %}
{
  "name": "Influencer Collections",
  "class": "tp-influencer-collections",
  "settings": [
    {
      "type": "color",
      "id": "background-color",
      "label": "Background Color",
      "default": "#F6F6F6"
    },
    {
      "type": "text",
      "id": "button_title",
      "label": "Button's Heading",
      "default": "View all collection"
    },
    {
      "type": "url",
      "id": "button_link",
      "label": "Button link"
    }
  ],
  "blocks": [
    {
      "type": "collection",
      "name": "collection",
      "settings": [
        {
          "type": "text",
          "id": "heading",
          "label": "Heading"
        },
        {
          "type": "richtext",
          "id": "content",
          "label": "About Collection"
        },
        {
          "id": "placeholder_image",
          "type": "image_picker",
          "label": "Collection Image"
        },
        {
          "type": "collection",
          "id": "collection",
          "label": "Collection"
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "Influencer Collections",
    }
  ]
}
{% endschema %}
