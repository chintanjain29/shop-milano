<div class="container mobile-full-container">
  <div class="tp-influencer-explore-container">
    <div class="tp-explore-header">
      <h2 class="banner-content-title">{{ section.settings.heading }}</h2>
    </div>
    <div class="tp-influencer-explore-collections-wrapper influencer-explore-desktop">
      {% for block in section.blocks %}
        <div class="tp-influencer-explore-collections">
          {% assign collection = block.settings.collection %}
          <a class="tp-influencer-explore-collections-card" href="{{ collection.url }}">
            {% if block.settings.collection_image %}
              <img src="{{ block.settings.collection_image | img_url: 'master' }}">
            {% else %}
              <img src="{{ collection.featured_image | img_url: 'master' }}">
            {% endif %}

            {% if block.settings.heading != '' %}
              <h3 class="tp-influencer-explore-collections-title">{{ block.settings.heading }}</h3>
            {% else %}
              <h3 class="tp-influencer-explore-collections-title">{{ collection.title }}</h3>
            {% endif %}

            {% if block.settings.content != '' %}
              {{ block.settings.content }}
            {% else %}
              <p>{{ collection.description }}</p>
            {% endif %}
          </a>
        </div>
      {% endfor %}
    </div>

    <div class="tp-influencer-explore-buttons ">
      <a class="btn small-feature-link white-btn" href="{{ section.settings.button_link }}">
        {{- section.settings.button_title -}}
      </a>
    </div>
  </div>
</div>

{%- liquid
  if section.settings.media_aspect_ratio == 's'
    assign custom_media_aspect_ratio = 0
    for block in section.blocks
      assign image = null
      if block.settings.image
        assign image = block.settings.image
      elsif block.settings.video_shopify
        assign image = block.settings.video_shopify.preview_image
      endif
      if image and image.aspect_ratio > custom_media_aspect_ratio
        assign custom_media_aspect_ratio = image.aspect_ratio
      endif
    endfor

  elsif section.settings.media_aspect_ratio == 't'
    assign custom_media_aspect_ratio = 9999999
    for block in section.blocks
      assign image = null
      if block.settings.image
        assign image = block.settings.image
      elsif block.settings.video_shopify
        assign image = block.settings.video_shopify.preview_image
      endif
      if image and image.aspect_ratio < custom_media_aspect_ratio
        assign custom_media_aspect_ratio = image.aspect_ratio
      endif
    endfor

  else
    assign custom_media_aspect_ratio = section.settings.media_aspect_ratio | plus: 0
  endif

  assign all_icons = true
  for block in section.blocks
    if block.settings.show_icon == false
      assign all_icons = false
      break
    endif
  endfor
-%}
<link rel="stylesheet" href="{{ 'feature-rating.css' | asset_url }}" {%- render 'lazy-stylesheet-attrs' %}>
<link rel="stylesheet" href="{{ 'scrolling-image-list.css' | asset_url }}" {%- render 'lazy-stylesheet-attrs' %}>
<script src="{{ 'scrolling-image-list.js' | asset_url }}" defer></script>

{%- for block in section.blocks -%}
  {%- if block.settings.video_shopify != blank -%}
    <link rel="stylesheet" href="{{ 'video.css' | asset_url }}" {%- render 'lazy-stylesheet-attrs' %}>
    <script src="{{ 'video.js' | asset_url }}" defer></script>
    {%- break -%}
  {%- endif -%}
{%- endfor -%}

{% style %}
  {% for block in section.blocks %}
    #{{ section.id }}[data-current-index="{{ forloop.index }}"] {
      --text-color: {{ block.settings.text_color.rgb }};
      --heading-color: {{ block.settings.text_color.rgb }};
      --link-color: {{ block.settings.text_color.rgb }};
    }

    #{{ section.id }} .scrolling-image-list__background[data-index="{{ forloop.index }}"] {
      background: {{ block.settings.bg_gradient | default: block.settings.bg_color }};
    }

    #{{ section.id }}[data-current-index="{{ forloop.index }}"] [data-index="{{ forloop.index }}"] {
      --content-fade-delay: 200ms;
      --content-visibility: visible;
      opacity: 1;
    }

    #{{ section.id }}[data-current-index="{{ forloop.index }}"] .scrolling-image-list-dots__dot[data-index="{{ forloop.index }}"] {
      background: currentColor;
    }
  {% endfor %}
{% endstyle %}

<scrolling-image-list
  id="{{ section.id }}"
  data-current-index="1"
  class="scrolling-image-list block use-color-scheme fully-padded-row--{% if section.blocks.size > 1 %}large{% else %}medium{% endif %} influencer-explore-slide-list"
  style="--image-width: {{ section.settings.image_max_width }}px"
>
  {% for block in section.blocks %}
    <div class="scrolling-image-list__background" data-index="{{ forloop.index }}"></div>
  {% endfor %}
  <div class="container container--not-mobile">
    <div class="flexible-layout{% if section.blocks.size == 1 %} valign-middle{% endif %}">
      <div class="column column--half {% if section.settings.image_position == 'right' %}column--order-push-desktop{% endif %}">
        <carousel-slider class="carousel block" data-dispatch-events="true">
          <div class="slider slider--no-scrollbar fade-in-up" data-cc-animate data-cc-animate-delay="0.1s">
            <div class="slider__grid md:block">
              {% for block in section.blocks %}
                <div class="slider__item flex-none basis-full" {{ block.shopify_attributes }}>
                  {% assign collection = block.settings.collection %}
                  <div class="scrolling-image-list__image" data-index="{{ forloop.index }}" tabindex="0">
                    {%- if block.settings.video_shopify != blank -%}
                      {%- assign placeholder_image = block.settings.image
                        | default: section.settings.video_shopify.preview_image
                      -%}
                      <div class="video-section">
                        <div
                          class="height--adapt"
                          {% if custom_media_aspect_ratio %}
                            style="--aspect-ratio: {{ custom_media_aspect_ratio }}"
                          {% endif %}
                        >
                          <div class="height__image">
                            <deferred-media>
                              <template>
                                <video-component
                                  class="has-video"
                                  data-video-id="{{ section.id }}-{{ block.id }}"
                                  data-autoplay="true"
                                  data-background="false"
                                  data-natural-width="true"
                                >
                                  {{
                                    block.settings.video_shopify
                                    | video_tag:
                                      playsinline: true,
                                      controls: false,
                                      autoplay: true,
                                      muted: true,
                                      loop: true,
                                      poster: ''
                                    | replace: '<img ', '<img loading="lazy" hidden '
                                  }}
                                </video-component>
                              </template>
                            </deferred-media>
                            {%- liquid
                              if placeholder_image
                                render 'image' with placeholder_image, class: 'video-played-hidden', size_cols_desktop: 2, custom_aspect_ratio: custom_media_aspect_ratio
                              endif
                            -%}
                          </div>
                        </div>
                      </div>

                    {%- elsif block.settings.collection_image != blank -%}
                      {% if block.settings.collection_image %}
                        <img src="{{ block.settings.collection_image | img_url: 'master' }}">
                      {% else %}
                        <img src="{{ collection.featured_image | img_url: 'master' }}">
                      {% endif %}
                    {%- else -%}
                      <div class="placeholder-image">{{ 'image' | placeholder_svg_tag: 'placeholder-svg' }}</div>
                    {%- endif -%}

                    <div
                      class="mobile-only fully-spaced-row scrolling-image-list__content scrolling-image-list__content--mobile{% if block.settings.show_icon %} scrolling-image-list__content--with-icon{% if block.settings.show_segments and section.settings.segment_position == 'over-text' %} scrolling-image-list__content--icon-beside-rating{% endif %}{% endif %}"
                      data-index="{{ forloop.index }}"
                    >
                     

                      {%- if block.settings.show_icon -%}
                        {%- if block.settings.icon_image == blank -%}
                          {%- render 'icon', icon: block.settings.icon, size: 'large' -%}
                        {%- else -%}
                          <div class="icon icon--large">
                            {%- render 'image' with block.settings.icon_image, sizes: '38px', widths: '38, 76' -%}
                          </div>
                        {%- endif -%}
                      {%- endif -%}

                      {%- if block.settings.show_segments and section.settings.segment_position == 'over-text' -%}
                        <div class="feature-rating-row">
                          {% render 'feature-rating',
                            segments: block.settings.segments,
                            active_segment: block.settings.active_segment,
                            fill_segments: block.settings.fill_segments,
                            show_labels: block.settings.show_labels,
                            label_left: block.settings.label_left,
                            label_middle: block.settings.label_middle,
                            label_right: block.settings.label_right
                          %}
                        </div>
                      {%- endif -%}

                      {%- if block.settings.heading != blank -%}
                        <h3 class="h2 heading">{{ block.settings.heading }}</h3>
                      {%- endif -%}
                       {%- if section.settings.heading != blank -%}
                        <div class="subheading spaced-row" role="heading" aria-level="2">
                          {% if block.settings.content != '' %}
                            {{ block.settings.content }}
                          {% else %}
                            <p>{{ collection.description }}</p>
                          {% endif %}
                        </div>
                      {%- endif -%}

                      {%- if block.settings.text != blank -%}
                        <div class="rte">{{ block.settings.text }}</div>
                      {%- endif -%}

                      {%- if block.settings.show_segments and section.settings.segment_position == 'under-text' -%}
                        <div class="feature-rating-row">
                          {% render 'feature-rating',
                            segments: block.settings.segments,
                            active_segment: block.settings.active_segment,
                            fill_segments: block.settings.fill_segments,
                            show_labels: block.settings.show_labels,
                            label_left: block.settings.label_left,
                            label_middle: block.settings.label_middle,
                            label_right: block.settings.label_right
                          %}
                        </div>
                      {%- endif -%}
                    </div>
                  </div>
                </div>
              {% endfor %}
            </div>
          </div>

          <div class="scrolling-image-list-dots flex justify-center mobile-only js" role="presentation">
            {%- for block in section.blocks -%}
              <div class="scrolling-image-list-dots__dot" data-index="{{ forloop.index }}"></div>
            {%- endfor -%}
          </div>
        </carousel-slider>
      </div>

      <div class="column column--half desktop-only scrolling-image-list__content-column" data-cc-animate>
        <div class="scrolling-image-list__content-area">
          <div class="feature-text-paired">
            

            <div class="scrolling-image-list__content-list">
              {% for block in section.blocks %}
                <div
                  class="spaced-row scrolling-image-list__content{% if block.settings.show_icon %} scrolling-image-list__content--with-icon{% if block.settings.show_segments and section.settings.segment_position == 'over-text' %} scrolling-image-list__content--icon-beside-rating{% endif %}{% endif %}"
                  data-index="{{ forloop.index }}"
                  tabindex="0"
                >
                  {%- if block.settings.show_icon -%}
                    {%- if block.settings.icon_image == blank -%}
                      {%- render 'icon', icon: block.settings.icon, size: 'large' -%}
                    {%- else -%}
                      <div class="icon icon--large">
                        {%- render 'image' with block.settings.icon_image, sizes: '38px', widths: '38, 76' -%}
                      </div>
                    {%- endif -%}
                  {%- endif -%}

                  {%- if block.settings.show_segments and section.settings.segment_position == 'over-text' -%}
                    <div class="feature-rating-row">
                      {% render 'feature-rating',
                        segments: block.settings.segments,
                        active_segment: block.settings.active_segment,
                        fill_segments: block.settings.fill_segments,
                        show_labels: block.settings.show_labels,
                        label_left: block.settings.label_left,
                        label_middle: block.settings.label_middle,
                        label_right: block.settings.label_right
                      %}
                    </div>
                  {%- endif -%}

                  {%- if block.settings.heading != blank -%}
                    <h3 class="h2 heading">{{ block.settings.heading }}</h3>
                  {%- endif -%}
                  {%- if section.settings.heading != blank -%}
              <div
                class="subheading spaced-row{% if all_icons %} scrolling-image-list__subheading-with-icon{% endif %}"
                role="heading"
                aria-level="2"
              >
                {% if block.settings.content != '' %}
                  {{ block.settings.content }}
                {% else %}
                  <p>{{ collection.description }}</p>
                {% endif %}
              </div>
            {%- endif -%}

                  {%- if block.settings.text != blank -%}
                    <div class="rte">{{ block.settings.text }}</div>
                  {%- endif -%}

                  {%- if block.settings.show_segments and section.settings.segment_position == 'under-text' -%}
                    <div class="feature-rating-row">
                      {% render 'feature-rating',
                        segments: block.settings.segments,
                        active_segment: block.settings.active_segment,
                        fill_segments: block.settings.fill_segments,
                        show_labels: block.settings.show_labels,
                        label_left: block.settings.label_left,
                        label_middle: block.settings.label_middle,
                        label_right: block.settings.label_right
                      %}
                    </div>
                  {%- endif -%}
                </div>
              {% endfor %}
            </div>
          </div>
        </div>
      </div>
    </div>
  </div>
</scrolling-image-list>

        <div class="tp-influencer-collection-container">
    <a href="{{ section.settings.button_link }}" class="btn small-feature-link white-btn">{{ section.settings.button_title }}</a>
  </div>

{% schema %}
{
  "name": "Influencer Explore",
  "class": "tp-influencer-explore",
  "settings": [
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "More to Explore"
    },
    {
      "type": "text",
      "id": "button_title",
      "label": "Button's Heading",
      "default": "View all collection"
    },
    {
      "type": "url",
      "id": "button_link",
      "label": "Button link"
    }
  ],
  "blocks": [
    {
      "type": "collection",
      "name": "collection",
      "settings": [
        {
          "type": "collection",
          "id": "collection",
          "label": "Collection"
        },
        {
          "type": "text",
          "id": "heading",
          "label": "Heading"
        },
        {
          "type": "richtext",
          "id": "content",
          "label": "About Collection"
        },
        {
          "type": "image_picker",
          "id": "collection_image",
          "label": "collection Image"
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "Influencer Explore",
    }
  ]
}
{% endschema %}
