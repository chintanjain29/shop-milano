
  <div class="tp-influencer-stc-container" style="background-color:{{ section.settings.background-color }};">
    {% for block in section.blocks %}
      <div class="tp-influencer-stc">
        <div class="container mobile-full-container">
          <div class="tp-influencer-stc-details">
            <h3 class="banner-content-title">{{ block.settings.heading }}</h3>
            {{ block.settings.content }}
            <a href="{{ block.settings.button_link }}" class="btn small-feature-link white-btn">{{ block.settings.button_title }}</a>
          </div>
          <div class="tp-influencer-stc-image">
            <img src="{{ block.settings.placeholder_image | img_url: 'master' }}">
          </div>
        </div>
      </div>
    {% endfor %}
  </div>
{% schema %}
{
  "name": "Influencer Shop",
  "class": "tp-influencer-stc",
  "settings": [],
  "blocks": [
    {
      "type": "collection",
      "name": "collection",
      "settings": [
        {
          "type": "text",
          "id": "heading",
          "label": "Heading"
        },
        {
          "type": "richtext",
          "id": "content",
          "label": "content"
        },
        {
          "type": "text",
          "id": "button_title",
          "label": "Button's Heading",
          "default": "Shop the collection"
        },
        {
          "type": "url",
          "id": "button_link",
          "label": "Button link"
        },
        {
          "id": "placeholder_image",
          "type": "image_picker",
          "label": "Image"
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "Influencer Shop",
    }
  ]
}
{% endschema %}
