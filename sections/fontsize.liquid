  <script>
      class fontsize extends HTMLElement {
          constructor() {
              super();
              const button = document.querySelector('.btn.add-to-cart');
  
              let foundNumber = 2;
  
              const checkAndDisplayError = (selectedOptions) => {
                  let numberFound = false;
  
                  for (let i = 0; i < selectedOptions.length; i++) {
                      const value = selectedOptions[i];
                      const parsedNumber = parseInt(value, 10);
  
                      if (!isNaN(parsedNumber) && parsedNumber >= 2 && parsedNumber <= 11) {
                          numberFound = true;
                          foundNumber = parsedNumber;
                          return true;
                      }
                  }
                  return false;
              };
  
              const fontsizeField = document.getElementById('fontsizefield');
  
              const updateErrorAndButton = () => {
                  if (foundNumber === null) {
                      return;
                  }
  
                  if (fontsizeField.value.length === 0) {
                      if (foundNumber > 0) {
                          button.classList.add('fontsizedisabled');
                      } else {
                          button.classList.remove('fontsizedisabled');
                      }
                  } else if (fontsizeField.value.length !== foundNumber) {
                      button.classList.add('fontsizedisabled');
                  } else {
                      button.classList.remove('fontsizedisabled');
                  }
              };
  
              const initialSelectedOptions = Array.from(document.querySelectorAll('[name="options"]:checked')).map(el => el.value);
              if (checkAndDisplayError(initialSelectedOptions)) {
                  updateErrorAndButton();
              } else {
                  button.classList.add('fontsizedisabled');
              }
  
              document.addEventListener('on:variant:change', (event) => {
                  if (checkAndDisplayError(event.detail.selectedOptions)) {
                      updateErrorAndButton();
                  } else {
                      button.classList.add('fontsizedisabled');
                  }
              });
  
              fontsizeField.addEventListener('input', (event) => {
                  if (foundNumber !== null && event.target.value.length > foundNumber) {
                      event.target.value = event.target.value.slice(0, foundNumber);
                  }
                  updateErrorAndButton();
              });
  
              // Move keydown event listener to constructor
              fontsizeField.addEventListener('keydown', (event) => {
                  if (foundNumber !== null && fontsizeField.value.length >= foundNumber && event.key !== 'Backspace' && event.key !== 'Delete' && !event.metaKey && !event.ctrlKey) {
                      event.preventDefault();
                  }
              });
  
              // **Prevent button click ONLY if disabled**
              button.addEventListener('click', (event) => {
                  if (button.classList.contains('fontsizedisabled')) {
                      event.preventDefault();
                      event.stopImmediatePropagation();
                      return false;
                  }
              });
  
              // Prevent form submission if button is disabled
              const form = button.closest('form');
              if (form) {
                  form.addEventListener('submit', (event) => {
                      if (button.classList.contains('fontsizedisabled')) {
                          event.preventDefault();
                      }
                  });
              }
  
              // Initial button state
              updateErrorAndButton();
          }
      }
      customElements.define('font-size', fontsize);
  </script>
