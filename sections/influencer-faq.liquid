<div class="container mobile-full-container">
  <div class="tp-influencer-faq-container" style="background-color:{{ section.settings.background-color }};">
    <div class="tp-influencer-faq">
      <h3 class="banner-content-title">{{ section.settings.heading }}</h3>
      {% for block in section.blocks %}
        <div class="tp-influencer-faq-details">
          <h3 class="tp-influencer-faq-details-title">{{ block.settings.question }}</h3>
          {{ block.settings.answer }}
        </div>
      {% endfor %}
    </div>
    <div class="tp-influencer-faq-image">
      <img src="{{ section.settings.placeholder_image | img_url: 'master' }}">
    </div>
  </div>
</div>

{% schema %}
{
  "name": "Influencer FAQ",
  "class": "tp-influencer-faq",
  "settings": [
    {
      "type": "color",
      "id": "background-color",
      "label": "Background Color",
      "default": "#F6F6F6"
    },
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "Frequently Asked Questions"
    },
    {
      "id": "placeholder_image",
      "type": "image_picker",
      "label": "Author Image"
    }
  ],
  "blocks": [
    {
      "type": "faq",
      "name": "faq",
      "settings": [
        {
          "type": "text",
          "id": "question",
          "label": "Question"
        },
        {
          "type": "richtext",
          "id": "answer",
          "label": "Answer"
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "Influencer FAQ",
    }
  ]
}
{% endschema %}
