{%- liquid
  assign rtl_langs = 'ar,arc,dv,fa,ha,he,khw,ks,ku,ps,ur,yi' | split: ','
  assign current_lang = localization.language.iso_code | split: '-' | first
  if rtl_langs contains current_lang
    assign lang_dir = 'rtl'
  else
    assign lang_dir = 'ltr'
  endif
-%}
<!doctype html>
<html class="no-js" lang="{{ request.locale.iso_code }}" dir="{{ lang_dir }}">
  <head>
   {%- comment -%} CWV FIX: preconnect removed — jQuery is now self-hosted below {%- endcomment -%}
    <link rel="preconnect" href="https://cdn.shopify.com">

    {%- comment -%} CWV FIX: head-level LCP banner preload {%- endcomment -%}
    {%- liquid
      assign cwv_img_desktop = null
      assign cwv_img_mobile = null
      if settings.cwv_lcp_preload_enabled
        if request.page_type == 'index'
          assign cwv_img_desktop = settings.cwv_lcp_home_desktop
          assign cwv_img_mobile = settings.cwv_lcp_home_mobile
        elsif request.page_type == 'collection'
          assign cwv_img_desktop = settings.cwv_lcp_collection_desktop
          assign cwv_img_mobile = settings.cwv_lcp_collection_mobile
        endif
      endif

      comment
        CWV FIX: PDP gallery image preloads
      endcomment
    -%}
    {%- if cwv_img_desktop != blank or cwv_img_mobile != blank -%}
      {%- liquid
        assign cwv_banner_ladder = '340,480,740,980,1200,1400,1600,1920,2560' | split: ','
        assign cwv_mobile_ladder = '340,400' | split: ','
      -%}
      {%- if cwv_img_desktop != blank -%}
        {%- liquid
          assign cwv_desktop_srcset = ''
          for w in cwv_banner_ladder
            assign cwv_w_num = w | plus: 0
            if cwv_w_num <= cwv_img_desktop.width
              assign cwv_w_scaled = cwv_w_num | times: settings.image_quality
              assign cwv_w_url = cwv_img_desktop | image_url: width: cwv_w_scaled
              assign cwv_desktop_srcset = cwv_desktop_srcset | append: cwv_w_url | append: ' ' | append: cwv_w_num | append: 'w, '
            endif
          endfor
          assign cwv_desktop_srcset = cwv_desktop_srcset | remove_last: ', '
          assign cwv_desktop_href = cwv_desktop_srcset | split: ', ' | last | split: ' ' | first
        -%}
        <link rel="preload" as="image" fetchpriority="high" href="{{ cwv_desktop_href }}" imagesrcset="{{ cwv_desktop_srcset }}" imagesizes="100vw" media="(min-width: 768px)">
      {%- endif -%}
      {%- if cwv_img_mobile != blank -%}
        {%- liquid
          assign cwv_mobile_srcset = ''
          for w in cwv_mobile_ladder
            assign cwv_w_num = w | plus: 0
            if cwv_w_num <= cwv_img_mobile.width
              assign cwv_w_scaled = cwv_w_num | times: settings.image_quality
              assign cwv_w_url = cwv_img_mobile | image_url: width: cwv_w_scaled
              assign cwv_mobile_srcset = cwv_mobile_srcset | append: cwv_w_url | append: ' ' | append: cwv_w_num | append: 'w, '
            endif
          endfor
          assign cwv_mobile_srcset = cwv_mobile_srcset | remove_last: ', '
          assign cwv_mobile_href = cwv_mobile_srcset | split: ', ' | last | split: ' ' | first
        -%}
        <link rel="preload" as="image" fetchpriority="high" href="{{ cwv_mobile_href }}" imagesrcset="{{ cwv_mobile_srcset }}" imagesizes="100vw" media="(max-width: 767.98px)">
      {%- endif -%}
    {%- endif -%}
    {%- comment -%}
      CWV FIX: single, sized PDP LCP preload.
      Previously preloaded the first 3 media at full original size, which competed
      with the LCP image and didn't match the gallery's responsive URLs (double download).
      Now: first image of the active color/weight group only, with an imagesrcset/imagesizes
      pair identical to the gallery <img> so the browser preloads exactly one matching URL.
    {%- endcomment -%}
    {%- if settings.cwv_lcp_preload_enabled and request.page_type == 'product' and product -%}
      {%- liquid
        assign cwv_lcp_image = null
        if product.selected_or_first_available_variant
          assign cwv_vtitle = product.selected_or_first_available_variant.title | strip | downcase
          for cwv_m in product.media
            unless cwv_m.media_type == 'image'
              continue
            endunless
            assign cwv_parts = cwv_m.alt | split: '-'
            assign cwv_color = cwv_parts.first | strip | downcase
            assign cwv_weight = cwv_parts.last | strip | downcase
            if cwv_vtitle contains cwv_color and cwv_vtitle contains cwv_weight
              assign cwv_lcp_image = cwv_m.preview_image
              break
            endif
          endfor
        endif
        assign cwv_lcp_image = cwv_lcp_image | default: product.featured_media.preview_image
        if cwv_lcp_image
          assign cwv_pdp_sizes = '(min-width: 768px) 50vw, calc(100vw - 40px)'
          assign cwv_pdp_widths = '400,600,800,1000,1200,1400,1600' | split: ','
          assign cwv_pdp_srcset = ''
          for w in cwv_pdp_widths
            assign wn = w | plus: 0
            if wn <= cwv_lcp_image.width
              assign cwv_wurl = cwv_lcp_image | image_url: width: wn
              assign cwv_wn_str = wn | append: ''
              assign cwv_pdp_srcset = cwv_pdp_srcset | append: cwv_wurl | append: ' ' | append: cwv_wn_str | append: 'w, '
            endif
          endfor
          assign cwv_pdp_srcset = cwv_pdp_srcset | remove_last: ', '
        endif
      -%}
      {%- if cwv_lcp_image -%}
        <link rel="preload" as="image" href="{{ cwv_lcp_image | image_url: width: 800 }}" fetchpriority="high" imagesrcset="{{ cwv_pdp_srcset }}" imagesizes="{{ cwv_pdp_sizes }}">
      {%- endif -%}
    {%- endif -%}

