    "
  >
    <!-- Google Tag Manager (noscript) -->
<noscript><iframe src="https://www.googletagmanager.com/ns.html?id=GTM-W99NW4L"
height="0" width="0" style="display:none;visibility:hidden"></iframe></noscript>
<!-- End Google Tag Manager (noscript) -->
    <a class="skip-link visually-hidden" href="#content">{{ 'accessibility.skip_to_content' | t }}</a>

    {%- sections 'header-group' -%}
    {%- if template.name != 'index'  and template.name != 'milano-edit-standard-blog' -%}
      <div
        class="container desktop-only not-in-quickbuy"
        style="padding-top:20px"
      >
        <div class="page-header">
          {% render 'breadcrumbs', show_next_prev: true %}
        </div>
      </div>
    {% endif -%}
    {% comment %}
      {% unless template != blank or request.path contains '/policies/' %}
        {% section 'gem-find-iwto' %}
      {% endunless %}
    {% endcomment %}
    <main id="content" role="main">
      <div class="container cf">
        {{ content_for_layout }}
      </div>
    </main>

    {%- if request.path != '/challenge' -%}
      <div id="pagefooter">
        {%- sections 'footer-group' -%}
      </div>

      {%- sections 'overlay-group' -%}
    {%- endif -%}

    <a href="#" class="page-shade" aria-label="{{ 'general.navigation.close' | t }}"></a>
    <div class="overlay fixed top-0 right-0 bottom-0 left-0 js-overlay"></div>

    {%- if settings.after_add_to_cart == 'notification' -%}
      <script src="{{ 'added-notification.js' | asset_url }}" defer></script>
      <template id="AddedNotification">
        <added-notification class="added-notification added-notification--hidden">
          <div class="added-notification__message-area">
            <div class="added-notification__message-title"></div>
            <div class="added-notification__message-text underline-child">
              {{ 'products.product.added_to_cart_with_link_html' | t: cart_url: routes.cart_url }}
            </div>
          </div>
          <div class="added-notification__button-area">
            <button
              type="button"
              class="added-notification__close"
              aria-label="{{ 'general.icon_labels.close' | t | escape }}"
            >
              {%- render 'icon-close' -%}
            </button>
          </div>
        </added-notification>
      </template>
    {%- endif -%}
    {%- render 'swym-custom-header-counter' -%}

    <script>
      (function () {
      function replaceColour(root = document) {
      root.querySelectorAll('*:not(script):not(style)').forEach(el => {
      el.childNodes.forEach(node => {
      if (node.nodeType === Node.TEXT_NODE) {
      let text = node.textContent;
      // Singular only, case-specific
      text = text
      .replace(/\bColour\b/g, 'Color')
      .replace(/\bcolour\b/g, 'color')
      .replace(/\bColourless\b/g, 'Colorless')
      .replace(/\Select diamond\b/g, 'ADD TO RING')
      .replace(/\United States 6.0\b/g, 'United States 7.0')
      .replace(/\Select ring size\b/g, 'SELECT RING SIZE')
      .replace(/\Adding to cart\b/g, 'ADDING TO CART')
      .replace(/\Select Setting\b/g, 'SELECT SETTING')
      .replace(/\Select setting\b/g, 'SELECT SETTING')
      .replace(/\Add to cart\b/g, 'ADD TO CART')
      .replace(/\Finger Size\b/g, 'Rings will be shipped in 3-4 weeks');
      node.textContent = text;
      }
      });
      });
      }
      function init() {
      replaceColour();
      const observer = new MutationObserver(() => replaceColour());
      observer.observe(document.body, {
      childList: true,
      subtree: true
      });
      }
      document.addEventListener('DOMContentLoaded', init);
      })();
    </script>

    <script>
    (function() {
      var script = document.createElement('script');
      script.id = 'minty-onsite-script';
      script.src = 'https://cdn.addshoppers.com/minty/shopify-onsite/executeminty.js';
      script.async = true;
      script.defer = true;
      document.head.appendChild(script);
    })();
    </script>
  </body>
